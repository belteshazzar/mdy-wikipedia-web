node_modules/

# Build artifacts. `npm run build` writes these, and they are committed to
# the repo, but they are not worth keeping around in the working tree.
dist/

# Image derivatives, fetched from Commons' thumbnailer by
# pipeline/enrich-images.mjs --download. corpus/images.yaml records where each
# one came from, so they are reproducible and not worth committing.
static/img/

# Credentials for the rewriting pass. `pipeline/rewrite.mjs` reads
# ANTHROPIC_API_KEY from the environment; this is somewhere to keep it.
.env

# The rewriting pass's intermediates: `--emit` writes the request, the answer
# comes back, `--apply` composes the document. site/edited/ is the artifact and
# is committed; these two are regenerable from it and the corpus.
pipeline/requests/
pipeline/answers/
pipeline/checks/
pipeline/reports/
.DS_Store
