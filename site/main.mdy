+++
title: The Ancient World
description: >-
  Fifty cities of the ancient Near East — where they stood, who held them, and
  what is left. A fork of Wikipedia, laid out to be read.
baseURL: https://example.invalid
+++
% // One entry document decides everything: which files are articles, what URL
% // each gets, which archetype it is, and where its images come from. The look
% // is none of this file's business — it is `style-antiquity`, imported by
% // path, and swapping that line changes the site's appearance and nothing
% // else.
% import style from "../style-antiquity"
%
% const self = res.data
% const site = { title: self.title, description: self.description, baseURL: self.baseURL }
%
% // The rights manifest is a .yaml file in the site directory, so its fields
% // are merged into `meta` and it is queryable like any document. Joining on
% // it here is what puts a credit under every photograph.
% // The corpus is two rings and only this file says which is which: cities are
% // the entry point, and everything else is here because a city needed it
% // explained. A deity and a city are both just documents otherwise.
% const options = $.findOne({ path: "build.yaml" }) || {}
%
% // Where the site is rooted. Every absolute URL below is written from this,
% // and a page's `url` is the one place a slug becomes a path — so the
% // timeline, the glossary, the places chart and the search index all follow
% // from it without knowing it exists. A trailing slash is trimmed so that
% // `base + "/" + slug` is the same shape whether or not there is a base.
% const base = String(options.base || "").replace(/\/+$/, "")
%
% // The look needs it too — the wordmark, the nav and the two static assets
% // are the style package's, not this file's — and `site` is what every
% // layout is already handed.
% site.base = base
%
% const cityList = $.findOne({ path: "cities.yaml" })
% const isCity = {}
% for (const slug of (cityList && cityList.cities) || []) isCity[slug] = true
%
% const manifest = $.findOne({ path: "corpus/images.yaml" })
% const rights = (manifest && manifest.images) || {}
%
% const docs = $.find({}).filter(function (d) {
%   return d.path && d.path.indexOf("corpus/en/") === 0 && d.ext === ".mdy"
% })
%
% // A rewrite, where there is one. It never replaces the import — it is a
% // second document that names the revision it was made from — so the site
% // holds both and shows the rewrite, with `/compare/<slug>/` holding the two
% // side by side, which is the whole question phase 2 exists to answer.
% const rewrites = {}
% for (const d of $.find({})) {
%   if (!d.path || d.path.indexOf("edited/en/") !== 0 || d.ext !== ".mdy") continue
%   rewrites[d.path.slice("edited/en/".length, -".mdy".length)] = d
% }
%
% const slugOf = function (path) { return path.slice("corpus/en/".length, -".mdy".length) }
%
% // Phase 1, one article at a time. The work itself is in
% // layouts/page-facts.mdy — a document, not a loop body, so that each
% // article's facts can be reused from the last build when that article did
% // not change. It asks the host for nothing, which is what makes it keepable;
% // the price of that is this file handing it everything it needs, which is
% // its own front matter, its rewrite, and the manifest records for its own
% // pictures. Sending the whole manifest instead would be sending two
% // megabytes per article, which is the mistake the payload used to make.
% const pages = []
%
% for (const doc of docs) {
%   const slug = slugOf(doc.path)
%   const edited = rewrites[slug]
%
%   const rightsFor = {}
%   for (const image of doc.images || []) {
%     if (image.file && rights[image.file]) rightsFor[image.file] = rights[image.file]
%   }
%   for (const entry of (edited && edited["image-plan"]) || []) {
%     if (entry.file && rights[entry.file]) rightsFor[entry.file] = rights[entry.file]
%   }
%
%   // Only the fields page-facts computes with. `infoboxKeys` is read here,
%   // where the order is the one the infobox rows have always had — see
%   // page-facts.mdy; the VM's key order is its own business and does not
%   // survive being handed across.
%   const worked = JSON.parse($.text({ path: "layouts/page-facts.mdy" }, {
%     doc: {
%       coordinates: doc.coordinates, infobox: doc.infobox, wikidata: doc.wikidata,
%       images: doc.images, image: doc.image
%     },
%     imagePlan: (edited && edited["image-plan"]) || [],
%     rights: rightsFor,
%     infoboxKeys: Object.keys(doc.infobox || {})
%   }))
%
%   pages.push({
%     path: edited ? edited.path : doc.path,
%     originalPath: doc.path,
%     edited: Boolean(edited),
%     hook: edited ? edited.hook : undefined,
%     rewritten: edited ? edited.rewritten : undefined,
%     slug: slug, url: base + "/" + slug + "/",
%     title: doc.title || slug,
%     description: (edited && edited.standfirst) || doc.description,
%     eyebrow: worked.eyebrow, sections: doc.sections || [],
%     hero: worked.hero, facts: worked.facts, held: worked.held, plan: worked.plan,
%     isPlace: worked.isPlace, kind: worked.kind, source: doc.source || {},
%     core: Boolean(isCity[slug]),
%     coordinates: doc.coordinates,
%     titles: doc["link-titles"] || {},
%     figures: worked.figures,
%     sitelinks: (doc["lang-links"] || []).length
%   })
% }
%
% pages.sort(function (a, b) { return a.title < b.title ? -1 : 1 })
%
% // Which slugs this corpus actually holds. A link to one of them is a link
% // into the fork; every other link leaves it, and says so.
% const here = {}
% for (const page of pages) here[page.slug] = true
%
% for (const page of pages) {
%   const cards = page.isPlace && (page.facts.length || page.held.length)
%     ? $.render({ path: "layouts/place.mdy" }, { kind: "Where, and whose", facts: page.facts, held: page.held })
%     : (page.facts.length ? $.render({ path: "layouts/facts.mdy" }, { kind: "In brief", facts: page.facts }) : undefined)
%
%   const body = $.render({ path: page.path })
%   const article = $.render({ path: "layouts/article.mdy" }, {
%     title: page.title, description: page.description, eyebrow: page.eyebrow,
%     hero: page.hero, sections: page.sections,
%     cards: cards, content: body, here: here, titles: page.titles,
%     figures: page.figures, hook: page.hook, plan: page.plan, base: base
%   })
%   const colophon = $.render({ path: "layouts/colophon.mdy" }, {
%     title: page.title, source: page.source,
%     rewritten: page.rewritten
%       ? "Model " + page.rewritten.model + ", from revision " + page.rewritten["source-revision"] +
%         ". " + (page.rewritten.verified ? "Checked against the source by a second pass." : "Not yet checked.") +
%         (page.rewritten.reviewed ? " Read by a person." : " Not yet read by a person.")
%       : undefined
%   })
%
%   // The two side by side, which is how the question gets answered — when
%   // anybody is asking. Off by default because each one renders both
%   // documents, and that is half the build.
%   if (page.edited && options.compare) {
%     const compare = $.render({ path: "layouts/compare.mdy" }, {
%       title: page.title, url: page.url,
%       before: $.render({ path: page.originalPath }),
%       after: $.render({ path: page.path }),
%       hook: page.hook, standfirst: page.description,
%       rewritten: page.rewritten
%     })
%     $.emit("compare/" + page.slug + "/index.html", style.render({ path: "layouts/base.mdy" }, {
%       content: compare, colophon: colophon, site: site,
%       page: { title: page.title + " — before and after", url: base + "/compare/" + page.slug + "/" }
%     }))
%   }
%
%   $.emit(page.slug + "/index.html", style.render({ path: "layouts/base.mdy" }, {
%     content: article, colophon: colophon, site: site,
%     page: { title: page.title, url: page.url, description: page.description }
%   }))
% }
%
% // The colophon a page that is not an article carries: the corpus as a whole
% // rather than one revision of one page.
% const siteColophon = $.render({ path: "layouts/colophon.mdy" }, {
%   title: site.title,
%   source: {
%     title: "Wikipedia", url: "https://en.wikipedia.org/", revision: "various",
%     retrieved: "2026-09-01",
%     "license-url": "https://creativecommons.org/licenses/by-sa/4.0/"
%   }
% })
%
% // ----------------------------------------------------------------- phase 4
% //
% // The pages no article contains. Every one of them is a query over the
% // corpus rather than something somebody wrote: the timeline is 372 dated
% // events from 25 articles in one column, the glossary is 199 terms each
% // defined by the article that needed it, the quotations are what the ancient
% // sources actually said, gathered. None of it exists on Wikipedia, because
% // Wikipedia has no way to ask.
%
% // A sortable year out of the way a historian writes one. Approximate by
% // design: "3rd millennium BC" is a thousand years wide and sorts to the
% // middle of them, which is the only honest place to put it.
% const RE_BC = /\bB\.?C\.?E?\b/i
% const RE_MILLENNIUM = /(\d+)(?:st|nd|rd|th)\s+millennium/i
% const RE_CENTURY = /(\d+)(?:st|nd|rd|th)\s+century/i
% const RE_WIDE = /(\d{3,4})/
% const RE_NARROW = /(\d{1,4})/
% const yearOf = function (text) {
%   const t = String(text)
%   const bc = RE_BC.test(t)
%   const millennium = RE_MILLENNIUM.exec(t)
%   const century = RE_CENTURY.exec(t)
%   // Three or four digits first: "24 August 394" must not sort as the year 24.
%   const wide = RE_WIDE.exec(t)
%   const narrow = RE_NARROW.exec(t)
%   let n
%   if (millennium) n = Number(millennium[1]) * 1000 - 500
%   else if (century) n = Number(century[1]) * 100 - 50
%   else if (wide) n = Number(wide[1])
%   else if (narrow) n = Number(narrow[1])
%   if (n === undefined) return undefined
%   return bc ? 0 - n : n
% }
%
% // Degrees to one place. A bounding box printed as 47.44194444 is a number
% // pretending to a precision the sentence around it does not have.
% // A term with its MDY markup and opening punctuation taken off, for filing.
% const folds = [
%   ["š", "s"], ["ṣ", "s"], ["ś", "s"], ["ṭ", "t"], ["ṯ", "t"], ["ṱ", "t"],
%   ["ḥ", "h"], ["ḫ", "h"], ["ḏ", "d"], ["ḍ", "d"], ["ġ", "g"], ["ʾ", ""],
%   ["ā", "a"], ["ē", "e"], ["ī", "i"], ["ō", "o"], ["ū", "u"], ["ʿ", ""]
% ]
%
% const sortable = function (text) {
%   let out = String(text).split("//").join("").split("!!").join("")
%   // Transliteration diacritics file under the letter they are: `šar kiššati`
%   // belongs at S, not in a group of its own after Z. Greek is left alone,
%   // because κρεμαστός is not a k with a mark on it.
%   for (const fold of folds) out = out.split(fold[0]).join(fold[1])
%   return out.replace(/^[^A-Za-z0-9\u00C0-\u024F\u0370-\u03FF]+/, "")
% }
%
% const round1 = function (n) { return Math.round(Number(n) * 10) / 10 }
%
% const ordinal = function (n) {
%   const rest = n % 100
%   if (rest > 10 && rest < 14) return n + "th"
%   const last = n % 10
%   if (last === 1) return n + "st"
%   if (last === 2) return n + "nd"
%   if (last === 3) return n + "rd"
%   return n + "th"
% }
%
% // Millennia before 1000 BC, centuries after. A century band across the third
% // millennium would be forty headings over material dated to the nearest five
% // hundred years.
% const bandOf = function (year) {
%   if (year <= -1000) {
%     const m = Math.ceil(0 - year / 1000)
%     return { key: 0 - m * 1000, label: ordinal(m) + " millennium BC" }
%   }
%   if (year < 0) {
%     const c = Math.ceil(0 - year / 100)
%     return { key: 0 - c * 100, label: ordinal(c) + " century BC" }
%   }
%   const c = Math.floor(year / 100) + 1
%   return { key: c * 100, label: ordinal(c) + " century AD" }
% }
%
% const events = []
% const terms = []
% const sayings = []
% const located = []
%
% for (const page of pages) {
%   const doc = rewrites[page.slug] || $.findOne({ path: "corpus/en/" + page.slug + ".mdy" })
%   if (!doc) continue
%
%   for (const entry of doc.timeline || []) {
%     const year = yearOf(entry.when)
%     if (year === undefined) continue
%     events.push({
%       year: year, when: entry.when, what: entry.what,
%       title: page.title, url: page.url
%     })
%   }
%
%   for (const entry of doc.glossary || []) {
%     if (!entry.term) continue
%     terms.push({
%       term: entry.term, gloss: entry.gloss,
%       title: page.title, url: page.url,
%       // A term keeps its markup when it is shown — half of these are
%       // transliterations and belong in italic — but it must not be filed
%       // under it. `//iššiak Aššur//` filed itself under a slash, and
%       // `'capitals'` under an apostrophe.
%       sort: sortable(entry.term),
%       initial: sortable(entry.term).slice(0, 1).toUpperCase()
%     })
%   }
%
%   for (const entry of doc["pull-quotes"] || []) {
%     if (!entry.text) continue
%     sayings.push({
%       text: entry.text, attribution: entry.attribution,
%       title: page.title, url: page.url
%     })
%   }
%
%   if (page.coordinates && page.coordinates.lat !== undefined) {
%     located.push({
%       title: page.title, url: page.url,
%       lat: Number(page.coordinates.lat), lon: Number(page.coordinates.lon),
%       when: page.eyebrow
%     })
%   }
% }
%
% events.sort(function (a, b) { return a.year - b.year })
% terms.sort(function (a, b) {
%   const x = String(a.sort).toLowerCase()
%   const y = String(b.sort).toLowerCase()
%   return x < y ? -1 : x > y ? 1 : 0
% })
%
% // Bands, in order, each with its events.
% const bands = []
% for (const event of events) {
%   const band = bandOf(event.year)
%   let last = bands.length ? bands[bands.length - 1] : undefined
%   if (!last || last.key !== band.key) {
%     last = { key: band.key, label: band.label, events: [] }
%     bands.push(last)
%   }
%   last.events.push(event)
% }
%
% // Terms, in order, each with its initial letter.
% const letters = []
% for (const term of terms) {
%   let last = letters.length ? letters[letters.length - 1] : undefined
%   if (!last || last.letter !== term.initial) {
%     last = { letter: term.initial, terms: [] }
%     letters.push(last)
%   }
%   last.terms.push(term)
% }
%
% $.emit("timeline/index.html", style.render({ path: "layouts/base.mdy" }, {
%   content: $.render({ path: "layouts/timeline.mdy" }, {
%     bands: bands, count: events.length, articles: pages.length
%   }),
%   colophon: siteColophon, site: site,
%   page: { title: "Timeline", url: base + "/timeline/" }
% }))
%
% $.emit("glossary/index.html", style.render({ path: "layouts/base.mdy" }, {
%   content: $.render({ path: "layouts/glossary.mdy" }, {
%     letters: letters, count: terms.length
%   }),
%   colophon: siteColophon, site: site,
%   page: { title: "Glossary", url: base + "/glossary/" }
% }))
%
% $.emit("quotations/index.html", style.render({ path: "layouts/base.mdy" }, {
%   content: $.render({ path: "layouts/quotations.mdy" }, {
%     quotes: sayings, count: sayings.length
%   }),
%   colophon: siteColophon, site: site,
%   page: { title: "Quotations", url: base + "/quotations/" }
% }))
%
% // A plotted chart rather than a map: there is no basemap to draw on, so it
% // shows where these places are in relation to each other and says so.
% let west = 999
% let east = -999
% let north = -999
% let south = 999
% for (const place of located) {
%   if (place.lon < west) west = place.lon
%   if (place.lon > east) east = place.lon
%   if (place.lat > north) north = place.lat
%   if (place.lat < south) south = place.lat
% }
% const pad = 2
% const plotted = []
% for (const place of located) {
%   plotted.push({
%     title: place.title, url: place.url, when: place.when,
%     lat: place.lat, lon: place.lon,
%     x: ((place.lon - (west - pad)) / ((east + pad) - (west - pad))) * 100,
%     y: (((north + pad) - place.lat) / ((north + pad) - (south - pad))) * 100
%   })
% }
%
% $.emit("places/index.html", style.render({ path: "layouts/base.mdy" }, {
%   content: $.render({ path: "layouts/places.mdy" }, {
%     places: plotted, count: plotted.length,
%     west: round1(west), east: round1(east), north: round1(north), south: round1(south)
%   }),
%   colophon: siteColophon, site: site,
%   page: { title: "Places", url: base + "/places/" }
% }))
%
% // The search index. `$.tokenize` is the host's own word-list algorithm — the
% // one nisaba uses — so what the widget matches on is what the database would
% // have matched on. Words are deduplicated: a 40,000-word article contributes
% // its vocabulary, not its length.
% const searchIndex = []
%
% for (const page of pages) {
%   const doc = rewrites[page.slug]
%   const parts = [page.title, page.description || ""]
%   if (page.hook) parts.push(page.hook)
%   parts.push($.text({ path: page.path }))
%   const seen = {}
%   const words = []
%   for (const word of $.tokenize(parts.join(" "))) {
%     if (seen[word]) continue
%     seen[word] = true
%     words.push(word)
%   }
%   searchIndex.push({ u: page.url, t: page.title, d: page.description || "", k: "article", w: words })
% }
%
% // A glossary term is worth finding on its own — somebody searching "lamassu"
% // wants the definition, and the article it came from second.
% for (const term of terms) {
%   searchIndex.push({
%     // The display form, with the italic markers taken off: a result reading
%     // `//lamassu//` is the markup leaking into the interface.
%     u: term.url, t: term.sort, d: term.gloss || "", k: "term",
%     w: $.tokenize(term.term + " " + (term.gloss || ""))
%   })
% }
%
% $.emit("search-index.json", JSON.stringify(searchIndex))
%
% const cities = []
% const ring = []
% let credited = 0
% for (const key of Object.keys(rights)) credited = credited + 1
% for (const page of pages) {
%   const card = {
%     url: page.url, title: page.title, description: page.description,
%     image: page.hero ? page.hero.src : undefined, meta: page.eyebrow
%   }
%   if (page.core) cities.push(card)
%   else ring.push(card)
% }
%
% const index = $.render({ path: "layouts/index.mdy" }, {
%   site: site, cities: cities, ring: ring, count: pages.length,
%   images: credited, located: plotted.length
% })

% $.emit("index.html", style.render({ path: "layouts/base.mdy" }, {
%   content: index, colophon: siteColophon, site: site,
%   page: { title: site.title, url: base + "/", description: site.description }
% }))
