% // The archetype every page shares. What differs between an article and a
% // place is which cards arrive in `req.cards`, already rendered — so a place
% // adds where it is and who held it without this file knowing either exists.
%% transform((tree) => {
  // Every link in an imported article is a slug — `[[ fort-julien ]]` — and
  // 96.6% of them name a page this corpus does not hold. Left alone they are
  // relative hrefs to nothing. So: one in the corpus becomes a link to it,
  // and one outside becomes a link to the Wikipedia article it came from,
  // marked as leaving. Neither is guessed — the corpus knows its own slugs,
  // and `link-titles` in the front matter carries the title behind each one.
  // A rewritten page's figures come from its image plan rather than from
  // markup, because the rewritten body has none. Walk the prose once, and put
  // each planned picture in front of the heading of the section it belongs to;
  // anything for the lead goes at the very top. Done by rebuilding the child
  // list rather than splicing during a visit, so nothing is inserted into an
  // array that is being walked.
  const plan = req.plan ?? []

  if (plan.length) {
    visit(tree, "element", (node) => {
      const classes = node.properties?.className ?? []
      if (!classes.includes || !classes.includes("prose")) return

      const figure = (item) => ({
        type: "element",
        tagName: "figure",
        properties: {className: ["planned", item.role]},
        children: [
          {
            type: "element",
            tagName: "img",
            properties: {
              src: item.src, alt: item.caption, loading: "lazy",
              width: item.width, height: item.height
            },
            children: []
          },
          {
            type: "element",
            tagName: "figcaption",
            properties: {},
            children: [
              {type: "text", value: item.caption},
              {
                type: "element",
                tagName: "span",
                properties: {className: ["credit"]},
                children: [{type: "text", value: item.credit}]
              }
            ]
          }
        ]
      })

      const out = []

      for (const item of plan) {
        if (item.section === "lead") out.push(figure(item))
      }

      for (const child of node.children) {
        if (child.type === "element" && child.tagName === "h2") {
          const id = child.properties?.id
          for (const item of plan) {
            if (item.section !== "lead" && item.section === id) out.push(figure(item))
          }
        }
        out.push(child)
      }

      node.children = out
    })
  }

  const prefixOf = (src) => {
    const at = String(src).lastIndexOf("/")
    return at === -1 ? String(src) : String(src).slice(0, at)
  }

  visit(tree, "element", (node) => {
    // The body's own images, in the places the article put them. They arrive
    // as the 250-pixel sidebar thumbnail Wikipedia rendered them at, which is
    // a quarter of the width this column shows them in — so each one is
    // swapped for the derivative the rights manifest recorded, and given the
    // credit that manifest went and got.
    if (node.tagName === "img") {
      const found = req.figures[prefixOf(node.properties.src)]
      if (!found) return
      node.properties.src = found.src
      node.properties.loading = "lazy"
      node.properties.width = found.width
      node.properties.height = found.height
      return
    }

    if (node.tagName === "figure") {
      let credit
      for (const child of node.children) {
        if (child.type !== "element" || child.tagName !== "img") continue
        const found = req.figures[prefixOf(child.properties.src)]
        if (found) credit = found.credit
      }
      if (!credit) return
      for (const child of node.children) {
        if (child.type !== "element" || child.tagName !== "figcaption") continue
        child.children.push({
          type: "element",
          tagName: "span",
          properties: {className: ["credit"]},
          children: [{type: "text", value: credit}]
        })
      }
      return
    }

    if (node.tagName !== "a") return
    const href = node.properties.href
    if (typeof href !== "string" || !href || href.indexOf(":") !== -1) return
    if (href.charAt(0) === "#" || href.charAt(0) === "/") return
    const slug = href.split("#")[0]
    const fragment = href.indexOf("#") === -1 ? "" : href.slice(href.indexOf("#"))
    if (req.here[slug]) {
      node.properties.href = "/" + slug + "/" + fragment
      return
    }
    const title = req.titles[slug]
    if (title) {
      node.properties.href = "https://en.wikipedia.org/wiki/" + title.split(" ").join("_")
      node.properties.className = ["out"]
      node.properties.rel = "noopener"
    }
  })
})
% const hero = req.hero
% const sections = req.sections ?? []

% if (hero) {
< section class="hero"
  <img class="hero-img" src="{{ hero.src }}" alt="{{ hero.alt }}" width="{{ hero.width }}" height="{{ hero.height }}"
  < div class="hero-text"
    % if (req.eyebrow) {
    <p class="eyebrow">{{ req.eyebrow }}
    % }
    <h1>{{ req.title }}
    % if (req.description) {
    <p class="standfirst">{{ req.description }}
    % }
% } else {
< section class="hero textual"
  < div class="hero-text"
    % if (req.eyebrow) {
    <p class="eyebrow">{{ req.eyebrow }}
    % }
    <h1>{{ req.title }}
    % if (req.description) {
    <p class="standfirst">{{ req.description }}
    % }
% }

< div class="page"
  % if (sections.length > 2) {
  < nav class="toc" aria-label="Contents"
    <p class="toc-head">Contents
    < ol
      % for (const s of sections) {
      < li class="depth-{{ s.level }}"
        <a href="#{{ s.id }}">{{ s.title }}
      % }
  % }

  % if (req.hook) {
  <p class="hook">{{ req.hook }}
  % }

  % if (req.cards) {
  {{ req.cards }}
  % }

  < div class="prose"
    {{ req.content }}
