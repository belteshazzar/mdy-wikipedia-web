source:
  site: Wikipedia
  lang: en
  title: Thebes, Egypt
  url: https://en.wikipedia.org/wiki/Thebes%2C_Egypt
  page-id: 65811
  revision: "1371463967"
  modified: 2026-08-26T16:03:31Z
  retrieved: 2026-09-01
  license: CC BY-SA 4.0
  license-url: https://creativecommons.org/licenses/by-sa/4.0/
