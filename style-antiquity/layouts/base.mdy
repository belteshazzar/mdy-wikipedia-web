<!doctype html>
< html lang="en"
  < head
    <meta charset="utf-8"
    <meta name="viewport" content="width=device-width, initial-scale=1"
    <title>{{ req.page.title && req.page.title !== req.site.title ? req.page.title + " — " + req.site.title : req.site.title }}
    <meta name="description" content="{{ req.page.description ?? req.site.description }}"
    <link rel="preconnect" href="https://fonts.googleapis.com"
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Archivo:wght@400;500;600&display=swap"
    <link rel="stylesheet" href="{{ req.site.base }}/style.css"
  < body
    < header class="site-head"
      <a class="wordmark" href="{{ req.site.base }}/">{{ req.site.title }}
      < nav class="site-nav"
        <a href="{{ req.site.base }}/">Articles
        <a href="{{ req.site.base }}/timeline/">Timeline
        <a href="{{ req.site.base }}/glossary/">Glossary
        <a href="{{ req.site.base }}/quotations/">Quotations
        <a href="{{ req.site.base }}/places/">Places
      < search class="site-search"
        <input id="search-input" type="search" placeholder="Search the corpus…" aria-label="Search" autocomplete="off"
        <ul id="search-results" hidden
    {{ req.content }}
    <script src="{{ req.site.base }}/search.js" data-base="{{ req.site.base }}"
    < footer class="colophon"
      {{ req.colophon }}
